rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /quizzes/{quizId} {
      allow read: if true;
      // This quick-start rule is intentionally open. For a production launch,
      // protect writes with Firebase Authentication and ownership checks.
      allow create, update, delete: if true;
      match /attempts/{attemptId} {
        allow read, write: if true;
      }
    }
  }
}
